{
  "name": "@claude-resurrect/core",
  "version": "0.0.1",
  "private": true,
  "description": "Shared logic for Claude Resurrect: the Claude Code hook, the session log and the restore planner.",
  "license": "MIT",
  "author": "Jakub Michalec <kuba.michalec@gmail.com>",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-hooks": "npm run build && node dist/install-hooks.js",
    "uninstall-hooks": "npm run build && node dist/install-hooks.js --uninstall",
    "sessions": "npm run build && node dist/show-sessions.js"
  }
}
