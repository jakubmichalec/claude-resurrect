{
  "name": "claude-resurrect-workspace",
  "private": true,
  "description": "Bring back the Claude Code CLI sessions that were open in your editor terminals before a restart.",
  "license": "MIT",
  "author": "Jakub Michalec <kuba.michalec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubmichalec/claude-resurrect.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "package": "npm run package --workspace packages/vscode",
    "install-hooks": "npm run install-hooks --workspace packages/core",
    "uninstall-hooks": "npm run uninstall-hooks --workspace packages/core",
    "sessions": "npm run sessions --workspace packages/core",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "ovsx": "^0.10.0",
    "prettier": "^3.9.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
